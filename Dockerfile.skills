# Build the IntelliAide skills image.
#
# Strategy:
#   Base image  = quay.io/rh-ee-cdate/intelliade-mcp-server:latest
#                 This is a PRIVATE Quay image that contains the full IntelliAide
#                 source code at /app/. It is never pushed to GitHub — the source
#                 code stays in GitLab and is only accessible via this image.
#
#   This file   = thin public wrapper; only the skills/ directory lives in Git.
#                 It adds /skills/intelliaide/ on top of the base image.
#
# Layout inside the final image:
#   /app/                          IntelliAide engine (from base image)
#     app_paths.py
#     Main-program/
#     python-client/
#     Machine-learning/
#     Config/
#     DataSource/
#     requirements.txt
#   /intelliaide/                  Skills wrapper (mounted at /app/skills/intelliaide/ in sandbox)
#     CLAUDE.md                    Orchestration instructions for Claude
#     extract_cluster.py           Step 1: live cluster extraction subprocess wrapper
#     select_files.py              Step 2: LLM-based file selection (high/medium/low priority)
#     analyze_data.py              Step 3: ML YAML classification + Drain3 log analysis
#     perform_rca.py               Step 4: LLM-based RCA (first pass or continuation)
#
# WHY /intelliaide/ and not /skills/intelliaide/:
#   The SandboxTemplate mounts the skills image volume at /app/skills in the container.
#   Kubernetes image volumes map the image root (/) to the mountPath.
#   So image path /intelliaide/ → container path /app/skills/intelliaide/  ✓
#   If we used /skills/intelliaide/ in the image, it would land at
#   /app/skills/skills/intelliaide/ in the container (double-nested, wrong).
#
# To build and push (private Quay — used as base for the above):
#   docker build -f Dockerfile -t quay.io/rh-ee-cdate/intelliade-mcp-server:latest .
#   docker push quay.io/rh-ee-cdate/intelliade-mcp-server:latest
#
# To build the skills image for OpenShift internal registry:
#   oc start-build lightspeed-skills -n openshift-lightspeed \
#     --from-dir=. --follow

# Stage 1 — copy IntelliAide source files from the private Quay image
FROM quay.io/rh-ee-cdate/intelliade-mcp-server:latest AS intelliaide-source

# Stage 2 — use UBI9 Python (same OS/glibc as the sandbox container)
FROM registry.access.redhat.com/ubi9/python-312

# All filesystem setup runs as root so we can write anywhere.
# We switch back to the default unprivileged user at the end.
USER root

# Copy IntelliAide source (Python files only — not the Debian runtime)
COPY --from=intelliaide-source /app /app

# Override Config/config.json from the build context so the correct Vertex AI
# endpoint_pattern and auth_type are always present regardless of the base image version.
COPY Config/config.json /app/Config/config.json

# Install IntelliAide dependencies to /app/intelliaide_deps.
# Using --target keeps packages at a predictable path regardless of where
# ubi9/python-312 normally puts site-packages (/opt/app-root/...).
# At runtime each skill script adds /app/skills/app/intelliaide_deps to sys.path
# (that is where /app/intelliaide_deps appears after the image is volume-mounted
# at /app/skills/ in the sandbox container).
RUN mkdir -p /app/intelliaide_deps && \
    pip install --no-cache-dir --target /app/intelliaide_deps -r /app/requirements.txt

# Copy skill wrappers at /intelliaide/ — no IntelliAide source code in Git.
# Image root maps to /app/skills/ in the container (SandboxTemplate mountPath),
# so these files land at /app/skills/intelliaide/ in the sandbox container.
COPY --chmod=755 skills/intelliaide/ /intelliaide/

# Scratch dir for live-cluster data
RUN mkdir -p /tmp/cluster-extract && \
    chgrp -R 0 /app /tmp/cluster-extract && \
    chmod -R g+rwX /app /tmp/cluster-extract

# Drop back to unprivileged user (OpenShift requires non-root)
USER 1001
